@model IEnumerable<Eventos.Web.Models.Asistente>
@{ ViewData["Title"] = "Asistentes"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="mb-1">Asistentes</h1><p class="text-muted mb-0">Personas activas registradas en la plataforma.</p></div><a asp-action="Create" class="btn btn-primary">Nuevo asistente</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
<div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Nombres</th><th>DNI</th><th>Correo</th><th>Teléfono</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.Nombres</strong></td><td>@item.Dni</td><td>@item.Correo</td><td>@item.Telefono</td></tr>}</tbody></table></div></div>
