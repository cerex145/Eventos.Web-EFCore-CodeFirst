@model IEnumerable<Eventos.Web.Models.Inscripcion>
@{ ViewData["Title"] = "Inscripciones"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="mb-1">Inscripciones</h1><p class="text-muted mb-0">Control de participantes y estados.</p></div><a asp-action="Create" class="btn btn-primary">Nueva inscripción</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
<div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Evento</th><th>Asistente</th><th>Fecha de inscripción</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Evento?.Titulo</td><td><strong>@item.Asistente?.Nombres</strong><br><small class="text-muted">@item.Asistente?.Dni</small></td><td>@item.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td><td><span class="badge @(item.Estado == "Confirmada" ? "bg-success" : "bg-secondary")">@item.Estado</span></td><td>@if(item.Estado == "Confirmada"){<form asp-action="Cancelar" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-danger">Cancelar</button></form>}</td></tr>}</tbody></table></div></div>
