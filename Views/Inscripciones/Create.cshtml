@model Eventos.Web.Models.Inscripcion
@{ ViewData["Title"] = "Nueva inscripción"; }
<h1>Nueva inscripción</h1><p class="text-muted">Seleccione un evento y un asistente activo.</p>
<div class="card shadow-sm"><div class="card-body"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="EventoId" class="form-label"></label><select asp-for="EventoId" asp-items="ViewBag.Eventos" class="form-select"><option value="">Seleccione un evento</option></select><span asp-validation-for="EventoId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="AsistenteId" class="form-label"></label><select asp-for="AsistenteId" asp-items="ViewBag.Asistentes" class="form-select"><option value="">Seleccione un asistente</option></select><span asp-validation-for="AsistenteId" class="text-danger"></span></div></div><div class="mt-4"><button class="btn btn-primary">Confirmar inscripción</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
