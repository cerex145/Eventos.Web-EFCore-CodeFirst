@model Eventos.Web.Models.Evento
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
    <div class="col-md-8"><label asp-for="Titulo" class="form-label"></label><input asp-for="Titulo" class="form-control"><span asp-validation-for="Titulo" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="CategoriaId" class="form-label"></label><select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select"><option value="">Seleccione</option></select><span asp-validation-for="CategoriaId" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Fecha" class="form-label"></label><input asp-for="Fecha" class="form-control"><span asp-validation-for="Fecha" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Lugar" class="form-label"></label><input asp-for="Lugar" class="form-control"><span asp-validation-for="Lugar" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="Aforo" class="form-label"></label><input asp-for="Aforo" class="form-control"><span asp-validation-for="Aforo" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="Precio" class="form-label"></label><input asp-for="Precio" class="form-control"><span asp-validation-for="Precio" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="Modalidad" class="form-label"></label><select asp-for="Modalidad" class="form-select"><option>Presencial</option><option>Virtual</option></select><span asp-validation-for="Modalidad" class="text-danger"></span></div>
</div>
