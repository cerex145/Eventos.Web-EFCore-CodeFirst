@model IEnumerable<Eventos.Web.ViewModels.EventoListadoVm>
@{ ViewData["Title"] = "Eventos"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="mb-1">Eventos</h1><p class="text-muted mb-0">Agenda de próximos eventos y disponibilidad.</p></div>
    <a asp-action="Create" class="btn btn-primary">Nuevo evento</a>
</div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
<form method="get" class="row g-2 mb-4">
    <div class="col-md-4"><select name="categoriaId" asp-items="ViewBag.Categorias" class="form-select"><option value="">Todas las categorías</option></select></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Filtrar</button></div>
</form>
<div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Evento</th><th>Categoría</th><th>Fecha</th><th>Modalidad</th><th>Cupos</th><th>Precio</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model) {
        <tr><td><strong>@item.Titulo</strong><br><small class="text-muted">@item.Lugar</small></td><td>@item.Categoria</td><td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td><span class="badge bg-info text-dark">@item.Modalidad</span></td><td>@item.CuposDisponibles / @item.Aforo</td><td>S/ @item.Precio.ToString("0.00")</td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Ver</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a></td></tr>
    }
    </tbody>
</table></div></div>
