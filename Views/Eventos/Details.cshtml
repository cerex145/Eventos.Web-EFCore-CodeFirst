@model Eventos.Web.Models.Evento
@{ ViewData["Title"] = "Detalle del evento"; }
<h1>@Model.Titulo</h1><p class="text-muted">Detalle completo del evento.</p>
<div class="card shadow-sm"><div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">Categoría</dt><dd class="col-sm-9">@Model.Categoria?.Nombre</dd><dt class="col-sm-3">Fecha</dt><dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd><dt class="col-sm-3">Lugar</dt><dd class="col-sm-9">@Model.Lugar</dd><dt class="col-sm-3">Modalidad</dt><dd class="col-sm-9">@Model.Modalidad</dd><dt class="col-sm-3">Aforo</dt><dd class="col-sm-9">@Model.Aforo</dd><dt class="col-sm-3">Precio</dt><dd class="col-sm-9">S/ @Model.Precio.ToString("0.00")</dd></dl></div></div>
<div class="mt-3"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a> <a asp-action="Index" class="btn btn-outline-secondary">Volver</a></div>
